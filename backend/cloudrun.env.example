# 微信云托管环境变量示例。请在云托管控制台填写真实值，不要提交密钥。
DIET_ENV=production
DIET_AUTH_DEV_MODE=0
DIET_IDENTITY_SECRET=replace-with-a-long-random-secret

# 正式环境必须使用持久化数据库；不要使用 json 或本地文件存储。
DIET_STORAGE_BACKEND=database
# 首次部署设为 1 自动建表；确认数据库初始化成功后改回 0。
DIET_DB_AUTO_CREATE=1
DATABASE_URL=mysql+pymysql://user:password@host:3306/diet_ai

WECHAT_APP_ID=wx01a9735b88504e16
WECHAT_APP_SECRET=
DIET_CORS_ORIGINS=https://servicewechat.com

# 可选：未配置模型密钥时后端使用规则模式。
DIET_AI_PROVIDER=rule
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
