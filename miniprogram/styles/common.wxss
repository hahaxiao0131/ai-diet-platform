page { background: #f5f8f5; color: #193b36; font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif; }
.page { padding: 32rpx; box-sizing: border-box; }
.brand { display: flex; align-items: center; gap: 18rpx; margin-bottom: 34rpx; }
.brand image { width: 92rpx; height: 92rpx; border-radius: 28rpx; background: #d8eee7; }
.brand-title { font-size: 40rpx; font-weight: 700; }
.brand-subtitle { color: #6d817a; font-size: 24rpx; margin-top: 6rpx; }
.card { background: #fff; border-radius: 26rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 12rpx 36rpx rgba(25, 59, 54, .06); }
.eyebrow { color: #087f73; font-size: 22rpx; letter-spacing: 2rpx; }
.card-title { font-size: 34rpx; font-weight: 700; margin: 10rpx 0 20rpx; }
.muted { color: #71847e; font-size: 25rpx; line-height: 1.65; }
.metric-row { display: flex; justify-content: space-between; gap: 18rpx; }
.metric { flex: 1; background: #f1f8f5; border-radius: 18rpx; padding: 20rpx; }
.metric-value { display: block; color: #087f73; font-size: 38rpx; font-weight: 700; }
.metric-label { display: block; color: #71847e; font-size: 22rpx; margin-top: 8rpx; }
.button { border: 0; border-radius: 18rpx; background: #087f73; color: white; font-size: 28rpx; padding: 22rpx 24rpx; line-height: 1.2; }
.button::after { border: 0; }
.button.secondary { background: #e4f2ee; color: #087f73; }
.button.warn { background: #fff1e7; color: #a55425; }
.button + .button { margin-left: 16rpx; }
.button-row { display: flex; gap: 16rpx; }
.button-row .button { flex: 1; margin: 0; }
.input { background: #f3f7f5; border-radius: 16rpx; padding: 22rpx; margin-bottom: 18rpx; font-size: 28rpx; }
.textarea { min-height: 160rpx; width: auto; }
.label { display: block; font-size: 24rpx; color: #71847e; margin-bottom: 10rpx; }
.list-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #edf1ef; }
.list-item:last-child { border-bottom: 0; }
.list-main { font-size: 28rpx; }
.list-sub { display: block; color: #899892; font-size: 22rpx; margin-top: 8rpx; }
.error { background: #fff1ed; color: #a44934; border-radius: 16rpx; padding: 18rpx; font-size: 24rpx; margin-bottom: 20rpx; line-height: 1.5; }
.success { background: #e7f6ee; color: #31724e; border-radius: 16rpx; padding: 18rpx; font-size: 24rpx; margin-bottom: 20rpx; }
.disclaimer { color: #81908a; font-size: 21rpx; line-height: 1.6; margin: 24rpx 4rpx; }
.empty { text-align: center; color: #8a9993; padding: 36rpx 0; font-size: 26rpx; }
