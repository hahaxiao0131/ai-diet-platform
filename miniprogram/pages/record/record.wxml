<view class="page">
  <view class="brand"><image src="/assets/shiji-ai-avatar.png" mode="aspectFill"/><view><view class="brand-title">添加记录</view><view class="brand-subtitle">选择一种方式，完成后会进入今日数据</view></view></view>
  <view class="segment"><text class="{{mode === 'meal' ? 'active' : ''}}" data-mode="meal" bindtap="switchMode">饮食记录</text><text class="{{mode === 'exercise' ? 'active' : ''}}" data-mode="exercise" bindtap="switchMode">运动记录</text></view>
  <view wx:if="{{message}}" class="{{success ? 'success' : 'error'}}">{{message}}</view>
  <view wx:if="{{mode === 'meal'}}" class="card"><view class="eyebrow">饮食记录</view><view class="card-title">记录吃过的食物</view><text class="label">食物名称</text><input class="input" value="{{foodName}}" placeholder="如 鸡胸肉" bindinput="onFoodName"/><text class="label">份量（克）</text><input class="input" type="digit" value="{{foodWeight}}" placeholder="如 100" bindinput="onFoodWeight"/><picker mode="selector" range="{{mealTypes}}" bindchange="onMealType"><view class="input">餐次：{{mealTypes[mealIndex]}}</view></picker><button class="button" loading="{{saving}}" bindtap="saveMeal">保存饮食记录</button><view wx:if="{{food}}" class="result">已找到：{{food.name}}<text class="list-sub">营养会由后端按份量计算</text></view></view>
  <view wx:if="{{mode === 'exercise'}}" class="card"><view class="eyebrow">运动记录</view><view class="card-title">记录今天的运动</view><text class="label">运动类型</text><input class="input" value="{{exerciseType}}" placeholder="如 网球、跑步、游泳" bindinput="onExerciseType"/><text class="label">时长（分钟）</text><input class="input" type="number" value="{{duration}}" placeholder="如 60" bindinput="onDuration"/><picker mode="selector" range="{{intensities}}" bindchange="onIntensity"><view class="input">强度：{{intensities[intensityIndex]}}</view></picker><button class="button" loading="{{saving}}" bindtap="saveExercise">保存运动记录</button></view>
  <view class="card"><view class="eyebrow">更自然的方式</view><view class="muted" style="margin:12rpx 0 20rpx">你也可以直接对 AI 说：“今天打了 60 分钟网球”或“我吃了鸡胸肉 100 克”。确认后才会写入记录。</view><button class="button secondary" bindtap="goAssistant">打开 AI 记餐</button></view>
</view>
