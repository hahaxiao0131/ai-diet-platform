@import "../../styles/common.wxss";
.hero { background: linear-gradient(135deg, #d9f0e8, #f9fbf7); border-radius: 30rpx; padding: 32rpx; margin-bottom: 24rpx; }
.hero-title { font-size: 44rpx; font-weight: 700; margin: 12rpx 0; }
.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.quick { background: #fff; border-radius: 22rpx; padding: 26rpx; color: #087f73; font-size: 28rpx; }
