DIET_AUTH_DEV_MODE=1
DIET_LOCAL_STORE_PATH=
DIET_DISABLE_PERSISTENCE=0
# json（本地原型）或 postgresql（正式数据库）
DIET_STORAGE_BACKEND=json
# 例如 postgresql+psycopg://diet_user:password@127.0.0.1:5432/diet_ai
DATABASE_URL=
# 本地开发可自动建表；生产环境建议设为 0 并执行 Alembic 迁移
DIET_DB_AUTO_CREATE=1
WECHAT_APP_ID=
WECHAT_APP_SECRET=
DIET_IDENTITY_SECRET=replace-with-a-long-random-secret
DIET_CORS_ORIGINS=http://127.0.0.1:5174
# rule 或 openai；未配置密钥时自动使用 rule
DIET_AI_PROVIDER=rule
# 仅由 FastAPI 后端读取
OPENAI_API_KEY=
# 官方 API 留空；兼容 Responses API 的中转服务填写其 base_url
OPENAI_BASE_URL=
# 填写当前 OpenAI Platform 账号可用的模型名称
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=low
DIET_AI_TIMEOUT_SECONDS=20
DIET_AI_MAX_RETRIES=1
DIET_AI_MAX_TOOL_TURNS=6
# Chroma 本地向量记忆目录；留空时使用 backend/data/chroma
DIET_CHROMA_PATH=
# DeepSeek 官方 Chat Completions Provider
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
# 联网食物查询：条码结构化数据优先，未命中时使用 DeepSeek Responses web_search
DIET_ONLINE_FOOD_SEARCH=1
DIET_ONLINE_FOOD_MODEL=deepseek-v4-flash
DIET_ONLINE_FOOD_TIMEOUT_SECONDS=30
DIET_ONLINE_FOOD_MAX_OUTPUT_TOKENS=4000
DIET_FOOD_SOURCE_TIMEOUT=4
DIET_FOOD_SOURCE_USER_AGENT=ShiJianDiet/0.1 (contact@example.com)

# 以下 VITE_ 配置应复制到 frontend/.env.local；Vite 不读取项目根目录的 .env。
# 留空时前端使用同源 /api/v1，本地开发由 Vite 代理到 FastAPI。
VITE_API_BASE_URL=
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
